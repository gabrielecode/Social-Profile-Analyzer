# ===================================================
# Social Profile Analyzer - Variabili d'ambiente
# ===================================================

# OPENROUTER_API_KEY: Chiave API obbligatoria per comunicare con OpenRouter.
# 1. Registrati o accedi su https://openrouter.ai
# 2. Vai su https://openrouter.ai/keys e genera una nuova chiave API
# 3. Incolla qui la chiave (inizia solitamente con 'sk-or-v1-...')
# NOTA DI SICUREZZA: Questa chiave viene letta ESCLUSIVAMENTE dal backend Express
# e non deve MAI essere condivisa né esposta al client frontend.
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# OPENROUTER_MODEL: Modello LLM da utilizzare per le analisi e i test.
# Default: meta-llama/llama-3.3-70b-instruct (veloce, economico ed efficace)
# Altri modelli supportati da OpenRouter:
# - openai/gpt-4o-mini
# - anthropic/claude-3.5-sonnet
# - google/gemini-2.5-flash
# - deepseek/deepseek-chat
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# PORT: Porta di ascolto del server Express (default 3000)
PORT=3000

# APP_URL: URL pubblico o locale dell'applicazione (usato negli header OpenRouter per metriche)
APP_URL="http://localhost:3000"

# ===================================================
# Aurora-ADV - Configurazione Contatti
# ===================================================
# CONTACT_WHATSAPP: Numero WhatsApp internazionale per ricezione richieste (senza +, es. 41764411359)
CONTACT_WHATSAPP="41764411359"

# CONTACT_EMAIL: Indirizzo email aziendale per preventivi e supporto
CONTACT_EMAIL="developers@graficawebdesign.com"

# CONTACT_URL: URL opzionale del sito web aziendale
# CONTACT_URL="https://aurora-adv.ch"

# ===================================================
# Integrazione API Protetta (/api/v1/*)
# ===================================================
# EXTERNAL_INTEGRATION_KEYS: Chiavi API autorizzate per l'accesso a /api/v1/* (separate da virgola)
# Esempio: "key_prod_a8f902b4e7,key_dev_c19d34e89f"
EXTERNAL_INTEGRATION_KEYS="spa_sec_key_example_123"

# ALLOWED_ORIGINS: Domini consentiti per richieste CORS da browser (opzionale, separati da virgola)
# Se vuoto o non impostato, nessun header CORS viene restituito.
# Esempio: "https://mio-sito.com,https://app.mio-sito.com"
ALLOWED_ORIGINS=""
